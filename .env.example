# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# PostgreSQL Configuration
# Neon Serverless Postgres
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Timezone (e.g. Asia/Phnom_Penh, Asia/Bangkok, Asia/Jakarta, UTC)
# Defaults to Asia/Phnom_Penh (UTC+7)
TIMEZONE=Asia/Phnom_Penh
